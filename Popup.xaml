<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           Margin="5,3,5,6" TextElement.Foreground="#172E44" UseLayoutRounding="True">
    <DockPanel.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#243E53"/>
            <Setter Property="Margin" Value="0,9,7,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" Background="#92FFFFFF" BorderBrush="#AAC0D2DC">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EEFFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D7E8F2"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#497794"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </DockPanel.Resources>
    <Path x:Name="Tip" DockPanel.Dock="Top" HorizontalAlignment="Left" Width="16" Height="8"
          Fill="#F1F7FBFD" Stroke="#BCD4DF" Data="M 0,8 L 8,0.8 L 16,8"/>
    <Border x:Name="Surface" CornerRadius="12" Padding="15,12" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F1F7FBFD" Offset="0"/>
                <GradientStop Color="#EBE6F1F7" Offset="0.6"/>
                <GradientStop Color="#E2DBECF6" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Color="#FAFFFFFF" Offset="0"/>
                <GradientStop Color="#BDCFE3ED" Offset="0.5"/>
                <GradientStop Color="#ABC0D2DE" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect><DropShadowEffect Color="#50677D" BlurRadius="7" ShadowDepth="2" Opacity="0.22"/></Border.Effect>
        <StackPanel><ScrollViewer x:Name="Scroll" MaxHeight="260" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="Body" TextWrapping="Wrap" FontSize="16" LineHeight="24"/>
        </ScrollViewer><WrapPanel x:Name="Actions"/></StackPanel>
    </Border>
</DockPanel>
