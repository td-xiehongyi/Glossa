<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           LastChildFill="True" Background="Transparent" UseLayoutRounding="True">
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1" CornerRadius="0,0,10,10">
            <DockPanel Style="{DynamicResource PageFooter}">
                <Button x:Name="SaveButton" Style="{DynamicResource PageAction}" Content="保存" IsDefault="True"/>
                <Button x:Name="ResetButton" Style="{DynamicResource PageAction}" Content="恢复默认" Margin="0,0,8,0"/>
                <TextBlock x:Name="Status" VerticalAlignment="Center"/>
            </DockPanel>
    </Border>
    <Grid DockPanel.Dock="Top">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Padding="20,4,20,0">
            <TextBlock Text="桌面效果预览" FontWeight="SemiBold"/>
        </Border>
        <Grid Grid.Row="1" x:Name="PreviewSlot">
            <Border x:Name="PreviewMat" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
        </Grid>
    </Grid>
    <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,12,20,0">
                    <GroupBox Header="基础设置" FontWeight="SemiBold">
                        <StackPanel x:Name="Basic" Margin="8,4,8,8" TextElement.FontWeight="Normal"/>
                    </GroupBox>
                    <Expander Header="高级外观" IsExpanded="True" FontWeight="SemiBold" Margin="0,12,0,0">
                        <StackPanel x:Name="Advanced" Margin="10,4,10,2" TextElement.FontWeight="Normal"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
    </Border>
</DockPanel>
