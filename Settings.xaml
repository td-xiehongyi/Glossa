<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" UseLayoutRounding="True">
 <Border.Resources>
  <Style x:Key="PageFooter" TargetType="DockPanel">
   <Setter Property="DockPanel.Dock" Value="Bottom"/>
   <Setter Property="Margin" Value="20,12,20,16"/>
  </Style>
  <Style x:Key="PageAction" TargetType="Button">
   <Setter Property="DockPanel.Dock" Value="Right"/>
   <Setter Property="MinWidth" Value="80"/>
   <Setter Property="Height" Value="32"/>
   <Setter Property="Padding" Value="12,0"/>
  </Style>
 </Border.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" CornerRadius="12,12,0,0" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
   <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#FFB9CFDA"/><Setter Property="BorderThickness" Value="1"/></Style></Border.Style>
   <DockPanel x:Name="TitleBar" Background="Transparent" Margin="18,10,12,9">
    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="×" AutomationProperties.Name="关闭设置" FontSize="19" Width="32" Background="Transparent" BorderThickness="0"/>
    <StackPanel Orientation="Horizontal"><TextBlock Text="Glossa" FontFamily="Segoe UI" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="设置" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15"/></StackPanel>
   </DockPanel>
  </Border>
  <TabControl x:Name="Pages" Background="Transparent" BorderThickness="0" Padding="0">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><DockPanel>
    <Border DockPanel.Dock="Top" Padding="15,6,15,6">
     <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFE7F1F6"/><Style.Triggers><DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
    </Border>
    <Border DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Padding="20,16,20,12">
     <TextBlock Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" FontSize="19" FontWeight="SemiBold"/>
    </Border>
    <ContentPresenter ContentSource="SelectedContent"/>
   </DockPanel></ControlTemplate></TabControl.Template>
   <TabControl.Resources><Style TargetType="TabItem">
    <Setter Property="Padding" Value="16,6"/><Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="Pill" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style></TabControl.Resources>
   <TabItem Header="翻译快捷键"/><TabItem Header="玻璃外观"/>
  </TabControl>
 </DockPanel>
</Border>
